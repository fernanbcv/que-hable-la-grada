{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/mi-app-angular/browser",
  "ignoreCommand": "test \"$VERCEL_ENV\" != \"production\"",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
